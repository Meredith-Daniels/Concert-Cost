# Copy this file to .env.local and fill in your values from Supabase.
# Concert Cost project → Settings → API Keys (or Connect dialog)
#
# Use the Project URL and the publishable (anon public) key only.
# Never put a service role or secret key in this file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Prefer the legacy "anon" "public" JWT from Supabase → Settings → API Keys if sign-up says "Invalid API key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_jwt_or_publishable_key

# App URL (required on Vercel — your production domain, no trailing slash)
# Local: http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Spotify — https://developer.spotify.com/dashboard
# Local redirect: http://127.0.0.1:3000/api/spotify/callback
# Production: https://YOUR_APP.vercel.app/api/spotify/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Bandsintown public app id (optional; defaults to concert-cost-tracker)
BANDSINTOWN_APP_ID=concert-cost-tracker

# Optional — more show coverage for For You (free): https://developer.ticketmaster.com/
# TICKETMASTER_API_KEY=your_ticketmaster_api_key
